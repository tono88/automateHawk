# Copia este archivo como .env (opcional). Todas las variables tienen valores por defecto.
# Nunca pongas aquí contraseñas: los secretos se generan solos en el volumen hub_secrets.

# --- Acceso al portal ---------------------------------------------------------
# Interfaz y puerto publicados. 127.0.0.1 = solo este equipo.
# Para la red interna usa la IP del servidor (o 0.0.0.0) y declara el nombre en HUB_ALLOWED_HOSTS.
HUB_BIND=127.0.0.1
HUB_PORT=8765
# Nombres o IP con los que se abrirá el portal además de localhost (separados por coma).
# HUB_ALLOWED_HOSTS=admisiones.unis.local,10.0.0.25
# 1 cuando el portal se publique detrás de un proxy HTTPS.
HUB_COOKIE_SECURE=0

# --- Edición hacia Oracle -----------------------------------------------------
# editor = puede guardar cambios en Oracle desde el portal; reader = solo consulta.
HUB_LOCAL_ROLE=editor
# Campos editables: default (oportunidad y contacto completos, salvo ID Campus, ID SCALA y
# Estado en Campus), safe (además excluye resolución, puntajes y % otorgados),
# verified (solo los probados de punta a punta), all, o una lista: name,stage,test_call
HUB_EDIT_FIELDS=default

# --- Sesión y permisos ------------------------------------------------------
HUB_IDLE_MINUTES=15
HUB_SESSION_MAX_HOURS=8
# Mientras se descarga la cartera la sesión sigue activa en segundo plano hasta terminar (máximo):
HUB_SYNC_MAX_HOURS=24
HUB_LIST_GRANT_MINUTES=60
HUB_DETAIL_GRANT_MINUTES=240
HUB_EDIT_GRANT_MINUTES=240
# Sincronización incremental: una ficha ya extraída se vuelve a leer solo si Oracle
# informa un cambio; además, como red de seguridad, tras estas horas (0 = nunca).
HUB_DETAIL_MAX_AGE_HOURS=168
# Al iniciar sesión se muestra de inmediato la última copia de lo que el usuario vio en Oracle
# en estos días, marcada «por reconfirmar» y sin edición hasta que Oracle la confirme (0 = desactivado).
HUB_STALE_VIEW_DAYS=7

# --- Rendimiento de la extracción ---------------------------------------------
HUB_READ_LANES=2
HUB_SCREEN_OPERATIONS=2

# --- Migración desde la instalación anterior (scripts/provision_local.py) ------
# Si tu .env anterior ya tiene esta línea, déjala: conserva la base existente.
# HUB_PG_ADMIN_SECRET_FILE=C:/Users/<usuario>/AppData/Local/automateHawk/postgres-admin.secret

# --- Oracle (solo si cambia el tenant) ----------------------------------------
# ORACLE_URL=https://ehvs.fa.us6.oraclecloud.com/hcmUI/faces/FuseWelcome
